# Copy to backend/.env. No real credentials belong in Git.
POSTGRES_DB=car_diagnostic
POSTGRES_USER=car_app
POSTGRES_PASSWORD=choose_a_unique_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://car_app:choose_a_unique_local_password@localhost:5432/car_diagnostic
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174","http://localhost:5173"]
MAX_REQUEST_BYTES=65536
RAG_ENABLED=true
# Optional learning corpus: similar-era VW references retain their actual source model.
RAG_ALLOW_RELATED_VOLKSWAGEN=false
# Optional: one bounded LLM call translates retrieval queries to English/French.
RAG_QUERY_EXPANSION_ENABLED=true
RAG_QUERY_EXPANSION_TIMEOUT_SECONDS=4
# Set a random token of at least 24 characters to enable document administration.
RAG_ADMIN_TOKEN=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
RAG_TOP_K=4
# Local BM25 bonus over eligible vector candidates; no additional AI call or index.
RAG_RERANK_CANDIDATES=40
# Set to 0 to retain the previous semantic/code ordering and candidate limit.
RAG_LEXICAL_WEIGHT=0.15
RAG_MIN_SIMILARITY=0.35
RAG_TIMEOUT_SECONDS=10
DOCUMENT_MAX_BYTES=4194304
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
# Automotive MCP: opt in; the default has no authorized live provider.
MCP_ENABLED=false
MCP_TRANSPORT=stdio
AUTOMOTIVE_PROVIDER=unavailable
MCP_HTTP_URL=http://127.0.0.1:8766/mcp
# Required only for HTTP; random secret of at least 24 characters.
MCP_TOKEN=
MCP_TIMEOUT_SECONDS=15
MCP_PROVIDER_TIMEOUT_SECONDS=5
MCP_MAX_RESULT_BYTES=32768
PARTS_COUNTRY=ES
PARTS_CURRENCY=EUR
# eBay Browse: select ebay (Production) or ebay_sandbox explicitly.
# Production App ID (Client ID) and Cert ID (Client Secret), not Dev ID or user token.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Sandbox credentials are separate; test offers must never be labelled live.
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
# Pending TecDoc onboarding only; these values do NOT enable a live provider.
# Request authorized credentials and the assigned API contract from TecAlliance.
# Inspected locally by: python -m app.mcp.tecdoc_setup (exit 1 = pending).
# Leave AUTOMOTIVE_PROVIDER=unavailable or explicitly use demo meanwhile.
TECDOC_API_KEY=
TECDOC_PROVIDER_ID=
TECDOC_ENDPOINT=
